APP_ENV=development
PAPER_TRADING=true
STARTING_EQUITY=10000
RISK_PER_TRADE=0.005
MAX_CONCURRENT_POSITIONS=8
MAX_DAILY_LOSS=0.02
MIN_CONFIDENCE=87
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
SCALPING_TIMEFRAME=5m
SWING_TIMEFRAME=1h
CANDLE_LIMIT=250
MAX_SCALP_POSITIONS=5
MAX_SWING_POSITIONS=3
SCALP_MIN_CONFIDENCE=87
SWING_MIN_CONFIDENCE=82
SCALPING_ENABLED=true
SWING_ENABLED=true

# Browser / OS push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:you@example.com
