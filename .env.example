APP_ENV=development
PAPER_TRADING=true
STARTING_EQUITY=10000
RISK_PER_TRADE=0.005
MAX_CONCURRENT_POSITIONS=8
MAX_DAILY_LOSS=0.02
MIN_CONFIDENCE=87
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,TRXUSDT,TONUSDT,SHIBUSDT,BCHUSDT,LTCUSDT,UNIUSDT,NEARUSDT,APTUSDT,SUIUSDT,ARBUSDT,OPUSDT,FILUSDT,ATOMUSDT,ETCUSDT,XLMUSDT,HBARUSDT,ICPUSDT,INJUSDT,PEPEUSDT,WIFUSDT,RENDERUSDT,GRTUSDT,AAVEUSDT,MKRUSDT,ALGOUSDT,VETUSDT,EOSUSDT,SANDUSDT,MANAUSDT,XTZUSDT,THETAUSDT,QNTUSDT,EGLDUSDT,RUNEUSDT,KASUSDT,SEIUSDT,JUPUSDT,TIAUSDT,ENAUSDT
SCALPING_TIMEFRAME=5m
SWING_TIMEFRAME=1h
CANDLE_LIMIT=250
MAX_SCALP_POSITIONS=12
MAX_SWING_POSITIONS=4
SCALP_MIN_CONFIDENCE=80
SWING_MIN_CONFIDENCE=82
SCALP_RISK_MULTIPLIER=0.6
SWING_RISK_MULTIPLIER=1.0
SCALPING_ENABLED=true
SWING_ENABLED=true
COLLECTOR_INTERVAL_SECONDS=2
DATA_DIR=data

# Optional push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:you@example.com

# Optional automatic GitHub analysis archive
GITHUB_SYNC_ENABLED=true
GITHUB_SYNC_INTERVAL_SECONDS=300
GITHUB_SYNC_REPO=bauermannricardo46-beep/tradebot
GITHUB_SYNC_BRANCH=main
GITHUB_SYNC_PATH=data/analysis_archive
GITHUB_SYNC_TOKEN=
